{
  "name": "Debian 服务监控面板",
  "listen": {
    "host": "0.0.0.0",
    "port": 8888
  },
  "services": [
    {
      "id": "auth-api",
      "name": "Auth API / 授权管理",
      "description": "公开授权 API 与 CE 授权后台",
      "match": {"port": 8787},
      "url": "https://{preview_host}/",
      "actions": []
    },
    {
      "id": "ce-x",
      "name": "CE-X 授权引擎",
      "description": "内部授权兼容引擎；公开预览仅用于诊断",
      "match": {"port": 8791},
      "url": "https://{preview_host}/v1/health",
      "actions": []
    },
    {
      "id": "jiankong",
      "name": "服务监控 / 保活中心",
      "description": "当前实例的服务监控与 Cloudflare 保活管理入口",
      "match": {"port": 8888},
      "url": "https://{preview_host}/guardian/",
      "link_label": "进入保活中心",
      "actions": []
    }
  ],
  "browser": {
    "enabled": true,
    "port": null
  },
  "multica": {
    "enabled": true,
    "executable": null,
    "working_directory": null,
    "runtime_id": null
  },
  "codex": {
    "enabled": true,
    "sessions_dir": null
  },
  "cloudflare_guardian": {
    "enabled": true,
    "worker_admin_url": "",
    "worker_config": {
      "upstreamOrigin": "",
      "taskId": "",
      "minSeconds": 780,
      "maxSeconds": 840,
      "keepaliveMessage": "1",
      "proxyTimeoutMs": 15000,
      "retryAfterSeconds": 30,
      "enabled": true
    }
  }
}
